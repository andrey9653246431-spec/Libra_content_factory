# --- Обязательные настройки Telegram ---
TG_BOT_TOKEN=1234567890:AAF_your_telegram_bot_token_here
TG_CHANNEL_ID=@your_libra_channel

# --- Режим публикации ---
# auto  — публиковать сразу в канал TG_CHANNEL_ID
# draft — отправлять черновик админу в личку (TG_ADMIN_ID) перед выкладкой
PUBLISH_MODE=auto
TG_ADMIN_ID=

# --- Настройки канала ---
CHANNEL_TITLE=Весы • Астропрогнозы
CHANNEL_HANDLE=@vesy_prognoz
TIMEZONE_OFFSET=3

# --- Бесплатный ИИ (достаточно ОДНОГО варианта на выбор; если не задано — работает встроенный офлайн-генератор) ---
# Вариант 1: Google Gemini (бесплатно в Google AI Studio, без карты)
GEMINI_API_KEY=
# Вариант 2: Groq (бесплатно на console.groq.com, без карты)
GROQ_API_KEY=
# Вариант 3: OpenRouter (бесплатные модели с :free на openrouter.ai)
OPENROUTER_API_KEY=
# Вариант 4: GitHub Models (в GitHub Actions работает автоматически через GITHUB_TOKEN)
GITHUB_TOKEN=

# Или задайте вручную любой OpenAI-совместимый API:
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
